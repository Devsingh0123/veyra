NODE_ENV=development
PORT=3002
SERVICE_NAME=catalog-service

# Database (MongoDB via Mongoose)
MONGODB_URI=mongodb://localhost:27017/veyra_catalog
DATABASE_URL=mongodb://localhost:27017/veyra_catalog

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / Cloudflare R2 Media Storage
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=veyra-media-dev
S3_PUBLIC_DOMAIN=https://media.veyra.in

# Client URLs (CORS)
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
