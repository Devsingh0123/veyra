RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Internal Services
ORDER_SERVICE_URL=http://localhost:3004

# Client URLs (CORS)
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
