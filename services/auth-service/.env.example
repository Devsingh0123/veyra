PORT=3001
NODE_ENV=development
SERVICE_NAME=auth-service

# Database (Prisma Multi-Schema)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/veyra_dev?schema=auth

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_min_32_characters_long_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_long_12345
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Client URLs (CORS)
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
